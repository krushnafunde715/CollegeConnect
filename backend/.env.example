# Flask & Security Configuration
FLASK_ENV=development
SECRET_KEY=collegeconnect-dev-super-secret-key-dpdp-2026
JWT_SECRET_KEY=collegeconnect-jwt-secret-key-2026
JWT_ACCESS_HOURS=8

# Database Configuration
# PostgreSQL (Production / Configured): postgresql://user:password@localhost:5432/collegeconnect
# SQLite fallback used for local development if PostgreSQL is unconfigured:
DATABASE_URL=sqlite:///collegeconnect.db

# Institution Configuration
INSTITUTION_NAME=CollegeConnect Institute of Technology
INSTITUTION_CODE=CCIT
INSTITUTION_DOMAIN=college.edu

# Email & Notification Delivery
# Leave empty for local development to capture emails in safe Dev Outbox
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=no-reply@college.edu
DEV_EMAIL_CAPTURE_ENABLED=true

# Security Tokens & Expirations
VERIFICATION_TOKEN_EXPIRE_HOURS=24
RESET_TOKEN_EXPIRE_MINUTES=60
INITIAL_SETUP_TOKEN=INIT-CCIT-SECURE-SETUP-KEY-2026

# Argon2 Tuning
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
